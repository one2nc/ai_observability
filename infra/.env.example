# Copy to .env and fill in values.

SINK=grafana
AI_GATEWAY=bifrost
BIFROST_PROVIDER=openai
BIFROST_API_KEY=replace-with-provider-token
BIFROST_PORT=8000
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4418

# Langfuse (SINK=langfuse, or `make langfuse-up` alongside another sink).
# These defaults match the headless bootstrap in sinks/langfuse/docker-compose.yml,
# so a fresh stack comes up with working keys and no UI signup. Change them for
# anything beyond local benchmarking.
LANGFUSE_PORT=3000
LANGFUSE_PUBLIC_KEY=pk-lf-11111111-1111-4111-8111-111111111111
LANGFUSE_SECRET_KEY=sk-lf-22222222-2222-4222-8222-222222222222
LANGFUSE_LLM_CONNECTION_WHITELISTED_HOST=host.docker.internal

# Phoenix (SINK=phoenix).
PHOENIX_PORT=6006
PHOENIX_OTLP_ENDPOINT=http://host.docker.internal:6006
PHOENIX_IMAGE=arizephoenix/phoenix:latest
PHOENIX_ENABLE_AUTH=true
PHOENIX_SECRET=change-me-phoenix-secret-32chars-min1digit1lower
PHOENIX_ADMIN_SECRET=change-me-phoenix-admin-secret-32chars-min1digit1lower
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=admin
