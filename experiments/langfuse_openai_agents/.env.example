# OpenAI Agents SDK
OPENAI_API_KEY=replace-me
OPENAI_MODEL=openrouter/gpt-4o-mini
OPENAI_AGENTS_API=chat_completions
# Optional: override base URL for a gateway
# OPENAI_BASE_URL=http://host.docker.internal:8000/v1

# For Bifrost, use the virtual key and chat-completions mode:
# OPENAI_API_KEY=<bifrost-virtual-key>
# OPENAI_AGENTS_API=chat_completions
# OPENAI_BASE_URL=http://host.docker.internal:8000/v1

# Langfuse — the only observability backend for this experiment. Traces, prompts,
# scores and datasets all go here. There is no OTLP endpoint and no collector
# gateway: Langfuse has no metrics or logs store, so nothing to send one.
#
# Get these from `cd ../../infra && make langfuse-keys`. The defaults match the
# headless bootstrap, so they work out of the box on a fresh stack.
# host.docker.internal, not localhost: the app runs in a container.
LANGFUSE_HOST=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=pk-lf-11111111-1111-4111-8111-111111111111
LANGFUSE_SECRET_KEY=sk-lf-22222222-2222-4222-8222-222222222222

# Attribution shown in Langfuse's Sessions and Users views
DEMO_USER_ID=demo-user

# Same as experiments 5-7, so traces stay comparable
AGENT_MAX_TURNS=3
