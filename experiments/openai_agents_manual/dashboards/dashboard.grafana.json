{
  "id": null,
  "uid": "openai-agents-manual",
  "title": "OpenAI Agents Manual - Hand-rolled OTel",
  "tags": ["ai-observability", "gen_ai", "openai_agents", "manual"],
  "description": "Manual tool-loop agent with hand-rolled OTel spans and metrics. All panels should populate - this is the baseline for full observability.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Manual OTel - GenAI Metrics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Agent Workflow Duration p95",
      "description": "End-to-end workflow execution latency.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(increase(gen_ai_client_operation_duration_seconds_bucket{service_name=\"ai-obs-openai-agents-manual\",gen_ai_operation_name=\"invoke_workflow\"}[$__range])) by (le))",
          "legendFormat": "invoke_workflow"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Tool Execution Duration p95",
      "description": "Latency of individual tool calls.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(increase(gen_ai_client_operation_duration_seconds_bucket{service_name=\"ai-obs-openai-agents-manual\",gen_ai_operation_name=\"execute_tool\"}[$__range])) by (le))",
          "legendFormat": "tools"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Model Call Duration p95",
      "description": "Latency of chat.completions.create calls.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(increase(gen_ai_client_operation_duration_seconds_bucket{service_name=\"ai-obs-openai-agents-manual\",gen_ai_operation_name=\"chat\"}[$__range])) by (le, gen_ai_request_model))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Token Usage",
      "description": "Input and output token consumption per model call.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gen_ai_client_token_usage_sum{service_name=\"ai-obs-openai-agents-manual\"}[$__range])) by (gen_ai_token_type, gen_ai_request_model)",
          "legendFormat": "{{gen_ai_request_model}} {{gen_ai_token_type}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Manual OTel - Agent Behavior (3 panels)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Operation Rate",
      "description": "Operations per second by type. Compare chat rate vs http_requests rate to see turn ratio.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gen_ai_client_operation_duration_seconds_count{service_name=\"ai-obs-openai-agents-manual\"}[1m])) by (gen_ai_operation_name)",
          "legendFormat": "{{gen_ai_operation_name}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"ai-obs-openai-agents-manual\",http_target=\"/ask\"}[1m]))",
          "legendFormat": "http_requests"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Model Turns per Request",
      "description": "Ratio of model calls to HTTP requests. A value of 2 means 2 model round-trips per user request.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gen_ai_client_operation_duration_seconds_count{service_name=\"ai-obs-openai-agents-manual\",gen_ai_operation_name=\"chat\"}[$__range])) / sum(increase(http_server_duration_milliseconds_count{service_name=\"ai-obs-openai-agents-manual\",http_target=\"/ask\"}[$__range]))",
          "legendFormat": "turns/request"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Time Breakdown %",
      "description": "Fraction of workflow time spent in model calls vs tool calls.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gen_ai_client_operation_duration_seconds_sum{service_name=\"ai-obs-openai-agents-manual\",gen_ai_operation_name=\"chat\"}[1m])) / sum(rate(gen_ai_client_operation_duration_seconds_sum{service_name=\"ai-obs-openai-agents-manual\",gen_ai_operation_name=\"invoke_workflow\"}[1m]))",
          "legendFormat": "model calls %"
        },
        {
          "refId": "B",
          "expr": "sum(rate(gen_ai_client_operation_duration_seconds_sum{service_name=\"ai-obs-openai-agents-manual\",gen_ai_operation_name=\"execute_tool\"}[1m])) / sum(rate(gen_ai_client_operation_duration_seconds_sum{service_name=\"ai-obs-openai-agents-manual\",gen_ai_operation_name=\"invoke_workflow\"}[1m]))",
          "legendFormat": "tool calls %"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "FastAPI - HTTP Metrics (auto-instrumented)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Request Rate",
      "description": "Traffic volume to POST /ask.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_duration_milliseconds_count{service_name=\"ai-obs-openai-agents-manual\",http_target=\"/ask\"}[$__range])) by (http_status_code)",
          "legendFormat": "{{http_status_code}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Request Duration p95 (ms)",
      "description": "User-visible end-to-end request latency.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(increase(http_server_duration_milliseconds_bucket{service_name=\"ai-obs-openai-agents-manual\",http_target=\"/ask\"}[$__range])) by (le))",
          "legendFormat": "POST /ask"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Active Requests",
      "description": "Concurrent in-flight requests.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "targets": [
        {
          "refId": "A",
          "expr": "http_server_active_requests{service_name=\"ai-obs-openai-agents-manual\"}",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Error Rate (5xx)",
      "description": "Rate of server errors.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"ai-obs-openai-agents-manual\",http_status_code=~\"5..\"}[1m])) by (http_target)",
          "legendFormat": "{{http_target}}"
        }
      ]
    }
  ]
}
