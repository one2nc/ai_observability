# Langfuse (running via infra/ — `make langfuse-up` there, or `make up SINK=langfuse`).
# Get these from `cd ../../infra && make langfuse-keys`. The defaults below match
# the headless bootstrap, so they work out of the box on a fresh stack.
#
# host.docker.internal, not localhost: these stages run inside containers.
LANGFUSE_HOST=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=pk-lf-11111111-1111-4111-8111-111111111111
LANGFUSE_SECRET_KEY=sk-lf-22222222-2222-4222-8222-222222222222

# LLM backend. Leave OPENAI_API_KEY unset to use the built-in deterministic mock
# so every stage runs with no provider account and reproducible traces.
# MODEL_NAME is still recorded on the generation either way.
MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=replace-me

# Point at the Bifrost gateway instead of OpenAI directly:
# OPENAI_API_KEY=<bifrost-virtual-key>
# OPENAI_BASE_URL=http://host.docker.internal:8000/v1
# MODEL_NAME=openai/gpt-4o-mini

# Shows up in Langfuse's Users view (stage 2 onward).
DEMO_USER_ID=demo-user
