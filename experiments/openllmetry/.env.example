# Embeddings
EMBED_API_KEY=your-embed-api-key
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536

# Chat (OpenRouter, direct, no gateway yet)
CHAT_API_KEY=your-openrouter-api-key
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=deepseek/deepseek-v4.1-flash

# Postgres + pgvector
DATABASE_URL=postgresql://rag:rag@host.docker.internal:5432/rag


# OpenTelemetry (shared gateway; sink selected in infra)
OTEL_SERVICE_NAME=ai-obs-openllmetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4418

# Capture prompt/response content on gen_ai spans (gen_ai.input.messages etc).
# true  = full prompt + completion text in spans (bigger payload, may hold PII)
# false = model/tokens/latency only, no message bodies
TRACELOOP_TRACE_CONTENT=true
